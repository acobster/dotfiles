#!/usr/bin/env bash

usage() {
  echo 'usage: tw [-h|--help] [--create] [-d|--dry-run] WORKTREE'
  echo
  echo '  -h|--help     print this help text'
  echo '  -n|--dry-run  do not execute any tmux commands, only output them'
  echo '     --create   create worktree'
}

POSITIONAL=()
while [[ $# -gt 0 ]]
do
key="$1"

case $key in
    -h|--help)
    # show usage and bail
    usage
    exit
    ;;
    --create)
    CREATE=1
    shift # past argument
    ;;
    -d|--dry-run)
    DRY_RUN=1
    shift # past argument
    ;;
    *)
    POSITIONAL+=("$1") # save it in an array for later
    shift # past argument
    ;;
esac
done

set -- "${POSITIONAL[@]}" # restore positional parameters

WORKTREE=$1
shift


main() {
  if [[ -n $CREATE ]] ; then
    local switch_cmd="wt switch --create $WORKTREE"
  else
    local switch_cmd="wt switch $WORKTREE"
  fi
  session_cmd="t -d -4 $WORKTREE $@"

  if [[ -n $DRY_RUN ]] ; then
    echo t -1 switch "$switch_cmd && $session_cmd && spd-say 'worktree session created'" -d
    echo tmux attach -t $WORKTREE
  else
    # Setup the new worktree, then create and attach a new tmux session once it's done.
    t -1 switch "$switch_cmd && $session_cmd && spd-say 'worktree session created'" -d
    tmux attach -t $WORKTREE
  fi
}


main $@
